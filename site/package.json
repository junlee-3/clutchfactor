    "test": "vitest",
    "test:run": "vitest run",
    "shots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.15",
    "sharp": "^0.35.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
